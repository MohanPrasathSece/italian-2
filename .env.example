# CryptoVest Capital — Environment Configuration
# Copy this file to `.env` and fill in your values.

# ─────────────────────────────────────────────────────────────
# CRM (Lead Management)
# ─────────────────────────────────────────────────────────────
# Primary CRM endpoint used for lead submissions
CRM_URL=https://api.myinvesttrade.com/api/lead_management/api/affiliates
CRM_ENDPOINT=https://api.myinvesttrade.com/api/lead_management/api/affiliates
# Affiliate token from CRM dashboard (MANDATORY)
CRM_TOKEN=AFF_1_697ac63e6f88cac9f990b1a5c4beaefd
CRM_AFFILIATE_TOKEN=AFF_1_697ac63e6f88cac9f990b1a5c4beaefd

# ─────────────────────────────────────────────────────────────
# Lead Dashboard (Counter)
# ─────────────────────────────────────────────────────────────
DASHBOARD_URL=https://lead-dashboard-orcin.vercel.app/api/increment
VITE_DASHBOARD_URL=https://lead-dashboard-orcin.vercel.app/api/increment

# ─────────────────────────────────────────────────────────────
# Vercel Blob Storage (Authentication via Blob)
# ─────────────────────────────────────────────────────────────
# Use `BLOB_READ_WRITE_TOKEN` or the BLOB_READ_WRITE_TOKEN_NEW format from Vercel
BLOB_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN_NEW_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN_NEW_STORE_ID=
BLOB_STORE_ID=

# ─────────────────────────────────────────────────────────────
# Website
# ─────────────────────────────────────────────────────────────
SITE_URL=https://cryptovestcapital.com
PORT=5000

# ─────────────────────────────────────────────────────────────
# SSL / TLS
# ─────────────────────────────────────────────────────────────
# Set to 0 to avoid SSL/TLS verification for the CRM endpoint (recommended)
NODE_TLS_REJECT_UNAUTHORIZED=0
